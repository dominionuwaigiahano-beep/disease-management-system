# Local development (PostgreSQL on your own machine)
DATABASE_URL=postgresql://postgres:YOURPASSWORD@127.0.0.1:5432/dts

# Production (Supabase). Use the CONNECTION POOLER string, port 6543,
# from Project Settings > Database > Connection string > Transaction mode.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Any long random string. Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-characters
